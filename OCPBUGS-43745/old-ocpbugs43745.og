func createReplicationController(clientset *kubernetes.Clientset, namespace string, index int) (*corev1.ReplicationController, error) {
	rc := &corev1.ReplicationController{
		ObjectMeta: metav1.ObjectMeta{
			Name:      fmt.Sprintf("web-server-rc%d", index),
			Namespace: namespace,
			Labels: map[string]string{
				"name": fmt.Sprintf("web-server-rc%d", index),
			},
		},
		Spec: corev1.ReplicationControllerSpec{
			Replicas: int32Ptr(1),
			Selector: map[string]string{
				"name": fmt.Sprintf("web-server-rc%d", index),
			},
			Template: &corev1.PodTemplateSpec{
				ObjectMeta: metav1.ObjectMeta{
					Labels: map[string]string{
						"name": fmt.Sprintf("web-server-rc%d", index),
					},
				},
				Spec: corev1.PodSpec{
					Containers: []corev1.Container{
						{
							Name:  "nginx",
							Image: "quay.io/openshifttest/nginx-alpine@sha256:04f316442d48ba60e3ea0b5a67eb89b0b667abf1c198a3d0056ca748736336a0",
							Ports: []corev1.ContainerPort{
								{
									Name:          "http",
									Protocol:      corev1.ProtocolTCP,
									ContainerPort: 8080,
								},
							},
						},
					},
				},
			},
		},
	}

	return clientset.CoreV1().ReplicationControllers(namespace).Create(context.TODO(), rc, metav1.CreateOptions{})
}

func createService(clientset *kubernetes.Clientset, namespace string, index int) (*corev1.Service, error) {
	service := &corev1.Service{
		ObjectMeta: metav1.ObjectMeta{
			Name:      fmt.Sprintf("service-unsecure%d", index),
			Namespace: namespace,
			Labels: map[string]string{
				"name": fmt.Sprintf("service-unsecure%d", index),
			},
		},
		Spec: corev1.ServiceSpec{
			Ports: []corev1.ServicePort{
				{
					Name:       "http",
					Port:       8080,
					Protocol:   corev1.ProtocolTCP,
					TargetPort: intstr.FromInt(8080),
				},
			},
			Selector: map[string]string{
				"name": fmt.Sprintf("web-server-rc%d", index),
			},
		},
	}

	return clientset.CoreV1().Services(namespace).Create(context.TODO(), service, metav1.CreateOptions{})
}

func createRouteDynamic(cfg *rest.Config, namespace string) (*unstructured.Unstructured, error) {
	dynClient, err := dynamic.NewForConfig(cfg)
	if err != nil {
		return nil, fmt.Errorf("failed to create dynamic client: %v", err)
	}

	routeGVR := schema.GroupVersionResource{Group: "route.openshift.io", Version: "v1", Resource: "routes"}
	route := &unstructured.Unstructured{
		Object: map[string]interface{}{
			"apiVersion": "route.openshift.io/v1",
			"kind":       "Route",
			"metadata": map[string]interface{}{
				"name":      "mytest",
				"namespace": namespace,
				"labels": map[string]interface{}{
					"name": "service-unsecure1",
				},
			},
			"spec": map[string]interface{}{
				"to": map[string]interface{}{
					"kind": "Service",
					"name": "service-unsecure1",
				},
				"port": map[string]interface{}{
					"targetPort": "http",
				},
				"wildcardPolicy": "None",
			},
		},
	}

	// Attempt to create the Route
	createdRoute, err := dynClient.Resource(routeGVR).Namespace(namespace).Create(context.TODO(), route, metav1.CreateOptions{})
	if err != nil {
		return nil, err
	}
	return createdRoute, nil
}

// createRoute creates a Route using the OpenShift Route clientset
func createRoute(routeClient *routeclientset.Clientset, namespace string) (*routev1.Route, error) {
	route := &routev1.Route{
		ObjectMeta: metav1.ObjectMeta{
			Name:      "mytest",
			Namespace: namespace,
			Labels: map[string]string{
				"name": "service-unsecure1",
			},
		},
		Spec: routev1.RouteSpec{
			To: routev1.RouteTargetReference{
				Kind: "Service",
				Name: "service-unsecure1",
			},
			Port: &routev1.RoutePort{
				TargetPort: intstr.FromString("http"),
			},
			WildcardPolicy: routev1.WildcardPolicyNone,
		},
	}

	// Create the Route and return it
	return routeClient.RouteV1().Routes(namespace).Create(context.TODO(), route, metav1.CreateOptions{})
}

func int32Ptr(i int32) *int32 { return &i }

func waitForReplicationControllerReady(clientset *kubernetes.Clientset, namespace, name string, replicas int32) error {
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()

	return wait.PollUntilContextCancel(ctx, 2*time.Second, true, func(ctx context.Context) (bool, error) {
		rc, err := clientset.CoreV1().ReplicationControllers(namespace).Get(ctx, name, metav1.GetOptions{})
		if err != nil {
			return false, err
		}
		return rc.Status.ReadyReplicas >= replicas, nil
	})
}

func waitForRouteAdmitted(dynamicClient dynamic.Interface, namespace, name string) error {
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()

	routeGVR := schema.GroupVersionResource{Group: "route.openshift.io", Version: "v1", Resource: "routes"}
	return wait.PollUntilContextCancel(ctx, 2*time.Second, true, func(ctx context.Context) (bool, error) {
		route, err := dynamicClient.Resource(routeGVR).Namespace(namespace).Get(ctx, name, metav1.GetOptions{})
		if err != nil {
			return false, err
		}

		// Check the route's status for an admitted condition
		status, found, err := unstructured.NestedSlice(route.Object, "status", "ingress")
		if err != nil || !found || len(status) == 0 {
			return false, nil // not admitted yet
		}

		for _, ingress := range status {
			ingressMap := ingress.(map[string]interface{})
			if conditions, found, _ := unstructured.NestedSlice(ingressMap, "conditions"); found {
				for _, condition := range conditions {
					conditionMap := condition.(map[string]interface{})
					if conditionMap["type"] == "Admitted" && conditionMap["status"] == "True" {
						return true, nil
					}
				}
			}
		}

		return false, nil
	})
}

func main() {
	namespace := flag.String("namespace", "ocpbugs43745", "The namespace to create resources in")
	flag.Parse()

	cfg, err := config.GetConfig()
	if err != nil {
		log.Fatalf("Failed to get Kubernetes config: %v\n", err)
	}

	clientset, err := kubernetes.NewForConfig(cfg)
	if err != nil {
		log.Fatalf("Failed to create Kubernetes clientset: %v\n", err)
	}

	if err := waitForHAProxyConfigCondition(clientset, cfg, "openshift-ingress", "mytest", "unsecure1", false); err != nil {
		log.Fatalf("Failed to wait for HAProxy configuration: %v\n", err)
	}

	N := 2

	for i := 1; i <= N; i++ {
		rc, err := createReplicationController(clientset, *namespace, i)
		if err != nil {
			log.Fatalf("Failed to create ReplicationController %d: %v\n", i, err)
		}
		log.Printf("Created ReplicationController %d\n", i)

		if false {
			if err := waitForReplicationControllerReady(clientset, *namespace, rc.Name, 1); err != nil {
				log.Fatalf("ReplicationController %d is not ready: %v\n", i, err)
			}
			log.Printf("ReplicationController %d is ready\n", i)
		}

		if _, err := createService(clientset, *namespace, i); err != nil {
			log.Fatalf("Failed to create Service %d: %v\n", i, err)
		}
		log.Printf("Created Service %d\n", i)
	}

	// Create OpenShift Route clientset
	routeClient, err := routeclientset.NewForConfig(cfg)
	if err != nil {
		log.Fatalf("Failed to create OpenShift route clientset: %v\n", err)
	}

	// Create the Route
	createdRoute, err := createRoute(routeClient, *namespace)
	if err != nil {
		log.Fatalf("Failed to create Route: %v\n", err)
	}
	log.Printf("Created Route %s pointing to service-unsecure1\n", createdRoute.Name)

	// Wait for the Route to be admitted
	if err := waitForRouteAdmitted(dynamic.NewForConfigOrDie(cfg), *namespace, createdRoute.Name); err != nil {
		log.Fatalf("Route %s was not admitted: %v\n", createdRoute.Name, err)
	}
	log.Printf("Route %s is admitted\n", createdRoute.Name)

	if err := waitForHAProxyConfigCondition(clientset, cfg, "openshift-ingress", "mytest", "unsecure1", true); err != nil {
		log.Fatalf("Failed to wait for HAProxy configuration: %v\n", err)
	}
	log.Println("HAProxy configuration is ready.")
}

// PodExecutor defines the interface for executing commands in pods
type PodExecutor interface {
	Execute(ctx context.Context, podName, namespace, container string, command []string) (string, string, error)
}

// k8sExecutor implements PodExecutor using the Kubernetes API
type k8sExecutor struct {
	clientset *kubernetes.Clientset
	config    *rest.Config
}

func NewPodExecutor(clientset *kubernetes.Clientset, config *rest.Config) PodExecutor {
	return &k8sExecutor{
		clientset: clientset,
		config:    config,
	}
}

func (e *k8sExecutor) Execute(ctx context.Context, podName, namespace, container string, command []string) (string, string, error) {
	req := e.clientset.CoreV1().RESTClient().
		Post().
		Resource("pods").
		Name(podName).
		Namespace(namespace).
		SubResource("exec").
		Param("container", container).
		Param("stdin", "false").
		Param("stdout", "true").
		Param("stderr", "true").
		Param("tty", "false")

	for _, cmd := range command {
		req.Param("command", cmd)
	}

	exec, err := remotecommand.NewSPDYExecutor(e.config, "POST", req.URL())
	if err != nil {
		return "", "", fmt.Errorf("failed to create executor: %v", err)
	}

	var stdout, stderr bytes.Buffer
	err = exec.StreamWithContext(ctx, remotecommand.StreamOptions{
		Stdout: &stdout,
		Stderr: &stderr,
	})
	if err != nil {
		return "", "", fmt.Errorf("failed to execute command: %v", err)
	}

	return stdout.String(), stderr.String(), nil
}

// RetryingExecutor adds retry capability to any PodExecutor
type RetryingExecutor struct {
	next     PodExecutor
	attempts int
	delay    time.Duration
}

func NewRetryingExecutor(next PodExecutor, attempts int, delay time.Duration) PodExecutor {
	return &RetryingExecutor{next: next, attempts: attempts, delay: delay}
}

func (r *RetryingExecutor) Execute(ctx context.Context, podName, namespace, container string, command []string) (stdout string, stderr string, err error) {
	for i := 0; i < r.attempts; i++ {
		stdout, stderr, err = r.next.Execute(ctx, podName, namespace, container, command)
		if err == nil {
			return stdout, stderr, nil
		}

		if i >= r.attempts-1 {
			return stdout, stderr, err
		}

		select {
		case <-ctx.Done():
			return stdout, stderr, fmt.Errorf("retry cancelled: %w", ctx.Err())
		case <-time.After(r.delay):
			// Continue to next retry
		}
	}
	return stdout, stderr, err
}

// containsBackend checks if the haproxy.config content has a backend entry
func containsBackend(configContent, routeName, expectedServiceName string) (bool, string) {
	scanner := bufio.NewScanner(strings.NewReader(configContent))
	var backendBlock []string
	inBackend := false

	for scanner.Scan() {
		line := scanner.Text()
		if strings.TrimSpace(line) == "" {
			continue
		}

		if strings.HasPrefix(line, "backend") {
			if strings.Contains(line, routeName) {
				inBackend = true
				backendBlock = append(backendBlock, line)
				log.Printf("Found backend start for %s", routeName)
			} else {
				inBackend = false
				backendBlock = nil
			}
			continue
		}

		if inBackend && (strings.HasPrefix(line, " ") || strings.HasPrefix(line, "\t")) {
			backendBlock = append(backendBlock, line)
			trimmedLine := strings.TrimSpace(line)
			if strings.HasPrefix(trimmedLine, "server") && strings.Contains(trimmedLine, expectedServiceName) {
				return true, strings.Join(backendBlock, "\n")
			}
		}
	}

	return false, ""
}

// checkHAProxyConfig checks if the haproxy.config in the specified pod contains the backend entry
func checkHAProxyConfig(executor PodExecutor, podName, namespace, routeName, expectedServiceName string) (bool, string, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	stdout, stderr, err := executor.Execute(ctx, podName, namespace, "router", []string{"cat", "/var/lib/haproxy/conf/haproxy.config"})
	if err != nil {
		return false, "", fmt.Errorf("failed to execute command in pod %s: %v\nstderr: %s", podName, err, stderr)
	}

	found, backendBlock := containsBackend(stdout, routeName, expectedServiceName)
	return found, backendBlock, nil
}

// waitForHAProxyConfigCondition waits until the backend entry for the route is present or absent
func waitForHAProxyConfigCondition(clientset *kubernetes.Clientset, cfg *rest.Config, namespace, routeName, expectedServiceName string, shouldBePresent bool) error {
	pods, err := clientset.CoreV1().Pods(namespace).List(context.TODO(), metav1.ListOptions{
		LabelSelector: "ingresscontroller.operator.openshift.io/deployment-ingresscontroller=default",
	})
	if err != nil {
		return fmt.Errorf("failed to list router pods: %v", err)
	}

	// Create an executor with retries
	baseExecutor := NewPodExecutor(clientset, cfg)
	executor := NewRetryingExecutor(baseExecutor, 3, time.Second)

	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()

	return wait.PollUntilContextCancel(ctx, 5*time.Second, true, func(ctx context.Context) (bool, error) {
		allPodsMatch := true
		for _, pod := range pods.Items {
			log.Printf("Checking HAProxy config in pod %s for %s of route %s",
				pod.Name,
				map[bool]string{true: "presence", false: "absence"}[shouldBePresent],
				routeName,
			)

			present, backendBlock, err := checkHAProxyConfig(executor, pod.Name, namespace, routeName, expectedServiceName)
			if err != nil {
				log.Printf("Error checking haproxy.config in pod %s: %v", pod.Name, err)
				return false, err
			}

			if present == shouldBePresent {
				if present {
					log.Printf("Backend entry for route %s is present in pod %s:\n%s\n", routeName, pod.Name, backendBlock)
				} else {
					log.Printf("Backend entry for route %s is absent in pod %s", routeName, pod.Name)
				}
			} else {
				allPodsMatch = false
				if present {
					log.Printf("Backend entry still present in pod %s; retrying...", pod.Name)
				} else {
					log.Printf("Backend entry not found in pod %s; retrying...", pod.Name)
				}
			}
		}

		return allPodsMatch, nil
	})
}
